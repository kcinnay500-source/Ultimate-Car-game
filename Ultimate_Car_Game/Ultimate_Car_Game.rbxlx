  <Item class="Lighting" referent="RBX004341">
    <Properties>
      <string name="Name">Lighting</string>
      <float name="Brightness">2.6</float>
      <float name="ClockTime">14.3</float>
      <bool name="GlobalShadows">true</bool>
      <float name="EnvironmentDiffuseScale">0.55</float>
      <float name="EnvironmentSpecularScale">0.65</float>
      <Color3 name="Ambient">
        <R>0.4862745</R>
        <G>0.5294118</G>
