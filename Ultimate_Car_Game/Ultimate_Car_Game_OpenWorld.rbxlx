		desc = "Glänzende Goldfelgen für jedes deiner Autos.", grants = { cosmetics = { "rims_gold" } }, creditsPrice = 1200 },
	{ key = "cos_horn_fanfare", kind = "cosmetic", name = "Fanfare", productId = 0,
